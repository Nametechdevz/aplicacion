# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env a un repositorio.

APP_NAME="Nailora Beauty"
# production | local
APP_ENV=production
# true solo en desarrollo: muestra detalles de errores
APP_DEBUG=false
# URL pública completa, sin barra final. Ej.: https://www.nailorabeauty.com o http://localhost/nailora-beauty
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nailora
DB_USERNAME=nailora_user
DB_PASSWORD=

SESSION_NAME=nailora_session
# auto | true | false  (auto = cookie Secure solo cuando la petición llega por HTTPS)
SESSION_SECURE=auto
# Minutos de inactividad antes de cerrar la sesión administrativa
ADMIN_SESSION_LIFETIME=120

# Token para el instalador web (/instalar). Déjelo vacío para desactivarlo.
# Use al menos 16 caracteres aleatorios y bórrelo al terminar la instalación.
INSTALL_TOKEN=

# Tamaño máximo de imágenes subidas, en MB
UPLOAD_MAX_MB=4
