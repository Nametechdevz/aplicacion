# Ruta del archivo SQLite (se crea automáticamente con sus migraciones).
DATABASE_PATH=./data/promptforge.db

# URL pública de la app (se usa para validar el encabezado Origin en peticiones que modifican datos).
# En desarrollo puede dejarse vacía: se compara contra el Host de la petición.
APP_URL=

# Opcional: habilita "Mejorar con IA" (Claude API). Sin esta variable el generador funciona igual,
# solo se desactiva la mejora asistida por IA.
ANTHROPIC_API_KEY=

# Permitir registro público de nuevas cuentas (true/false). El primer usuario siempre puede registrarse.
ALLOW_REGISTRATION=true

# Marca la cookie de sesión como Secure. Por defecto: true en producción.
# Póngala en false SOLO si sirve la app por HTTP plano (p. ej., en una red local).
COOKIE_SECURE=
