# Puerto HTTP del servidor
PORT=3000
# Secreto para firmar las sesiones. Si se deja vacío se genera uno y se guarda en data/jwt-secret.
JWT_SECRET=
# Ruta del archivo SQLite
DB_PATH=data/taxis.db

# Cuenta de la central. Se crea al arrancar; si cambias ADMIN_PASSWORD y reinicias, se actualiza la contraseña.
ADMIN_EMAIL=admin@taxiya.local
ADMIN_PASSWORD=
ADMIN_NAME=Central

# true = los conductores pueden trabajar sin aprobación de la central
DRIVER_AUTO_APPROVE=false
# Radio (km) en el que se avisa a los conductores de una solicitud
DISPATCH_RADIUS_KM=10
# Segundos que espera una solicitud antes de marcarse como "sin conductores"
RIDE_REQUEST_TIMEOUT_S=180

# Servicios de mapas (OpenStreetMap). Usa "none" para desactivarlos.
# Para producción con tráfico real, usa un servidor OSRM/Nominatim propio o un proveedor de pago.
ROUTING_URL=https://router.project-osrm.org
GEOCODER_URL=https://nominatim.openstreetmap.org
# Limita la búsqueda de direcciones a países (códigos ISO separados por comas, p. ej. "mx" o "es,ad")
GEOCODER_COUNTRY_CODES=

# Orígenes permitidos si el cliente web se sirve desde otro dominio (separados por comas)
CORS_ORIGIN=

# (Cliente, se aplica al compilar) centro del mapa cuando no hay GPS: "lat,lng"
VITE_DEFAULT_CENTER=4.7110,-74.0721

# Mapa base (opcional). Vacío = OpenStreetMap en la web y CARTO en la app Android.
# Ejemplo con MapTiler (clave gratuita en maptiler.com):
# TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_CLAVE
# TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
TILE_URL=
TILE_ATTRIBUTION=

# Zona horaria para "hoy", "esta semana" y las gráficas del panel (IANA). Por defecto, Colombia.
TIME_ZONE=America/Bogota
