<?xml version="1.0" encoding="utf-8"?>
<!-- Most IPTV servers only offer plain HTTP streams, so cleartext traffic is allowed.
     HTTPS servers keep full certificate validation with the system trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
