{
    "name": "jsperfumerias/pos",
    "description": "JS Perfumerías POS — sistema POS multisucursal para perfumerías",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Helpers/functions.php"]
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "test": "php tests/run.php"
    },
    "config": { "optimize-autoloader": true, "sort-packages": true }
}
