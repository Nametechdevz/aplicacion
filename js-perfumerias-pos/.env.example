# ------------------------------------------------------------------
# JS Perfumerías POS — variables de entorno
# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.
# ------------------------------------------------------------------
APP_NAME="JS Perfumerías POS"
APP_ENV=production            # production | local | testing
APP_DEBUG=false               # true solo en desarrollo: muestra trazas de error
APP_URL=https://pos.su-dominio.com
APP_TIMEZONE=America/Bogota
APP_LOCALE=es_CO
APP_CURRENCY=COP

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=js_perfumerias
DB_USERNAME=js_pos
DB_PASSWORD=

# Sesión
SESSION_NAME=jsp_session
SESSION_LIFETIME=480          # minutos de inactividad antes de cerrar la sesión
SESSION_SECURE=true           # true cuando el sitio se sirve por HTTPS (obligatorio en producción)

# Inicio de sesión: bloqueo por fuerza bruta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Imágenes de productos
UPLOAD_MAX_MB=5
